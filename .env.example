# Copy to .env, edit locally, and never commit the resulting file.
VPN_AWS_PROFILE=region-relay
VPN_TAILSCALE_HOSTNAME=aws-exit-node

# Recommended safety check. Replace with your 12-digit AWS account ID.
# VPN_EXPECTED_ACCOUNT=123456789012

# Optional overrides for advanced users.
# VPN_BUNDLE_ID=nano_3_1
# VPN_SCHEDULER_STACK=region-relay-scheduler
# VPN_SCHEDULE_NAME=region-relay-auto-down

